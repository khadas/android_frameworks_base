<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clickable="true"
    android:minHeight="200dp"
    android:padding="20dp">

    <RelativeLayout
        android:id="@+id/ebook_dialog_refresh_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">

        <TextView
            android:background="#ffffff"
            android:id="@+id/ebook_dialog_refresh_text"
            android:textColor="#000000"
            android:text="@string/ebook_refresh_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:textSize="20sp" />

        <Button
            android:id="@+id/ebook_dialog_refresh_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/ebook_dialog_refresh_checkbox"
            android:background="@drawable/ic_ebook_settings" />

        <CheckBox
            android:id="@+id/ebook_dialog_refresh_checkbox"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ebook_dialog_refresh_layout">

        <TextView
            android:id="@+id/ebook_dialog_color_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:background="#ffffff"
            android:text="@string/ebook_color_cfg"
            android:textColor="#000000"
            android:textSize="20sp" />

        <Button
            android:id="@+id/ebook_dialog_color_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="10dp"
            android:background="@drawable/ic_ebook_settings" />
    </RelativeLayout>

</RelativeLayout>
