<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:minHeight="180dp">

    <RelativeLayout
        android:id="@+id/ebook_rd_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/ebook_rd_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:text="@string/ebook_refresh_setting"
            android:textColor="@android:color/black"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/ebook_rd_mode_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ebook_rd_title_text"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ebook_refresh_dialog_mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ebook_refresh_mode"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/ebook_refresh_dialog_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/ebook_rd_frequency_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ebook_rd_mode_layout"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="20dp"
            android:text="@string/ebook_refresh_frequency"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ebook_rd_frequency_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/ebook_rd_frequency_title"
            android:layout_alignParentRight="true"
            android:ems="2"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/ebook_rd_frequency_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/ebook_rd_frequency_title"
            android:layout_alignBottom="@+id/ebook_rd_frequency_title"
            android:layout_toLeftOf="@+id/ebook_rd_frequency_value"
            android:layout_toRightOf="@+id/ebook_rd_frequency_title"
            android:max="100" />
    </RelativeLayout>

</FrameLayout>